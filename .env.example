# URL publica canonica, sem barra no final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Mercado Pago
NEXT_PUBLIC_MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_WEBHOOK_URL=http://localhost:3000/api/webhook

# Rate limiting distribuido
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Provedores visiveis na tela de login
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=true
NEXT_PUBLIC_AUTH_FACEBOOK_ENABLED=true
NEXT_PUBLIC_AUTH_AZURE_ENABLED=true

# E-mails transacionais: configurar somente no servidor/Functions da Netlify.
# Ativar apenas depois de instalar a migration customer_email_outbox.
CUSTOMER_EMAIL_ENABLED=false
SMTP_USER=
SMTP_APP_PASSWORD=
